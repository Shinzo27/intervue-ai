# Backend service environment

# PostgreSQL connection (matches infra/compose/docker-compose.dev.yml)
DATABASE_URL=postgresql://intervue:intervue_dev@localhost:5432/intervue_dev

# HTTP server
PORT=3000

# CORS / trusted frontend origin
FRONTEND_URL=http://localhost:3001

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-a-real-secret

# Service-to-service auth (shared with ai-service's BACKEND_INTERNAL_TOKEN)
INTERNAL_SERVICE_SECRET=change-me-internal-secret

# Redis (BullMQ). The invitation queue currently defaults to localhost:6379;
# REDIS_URL becomes the single source when the queue module is refactored.
REDIS_URL=redis://localhost:6379
