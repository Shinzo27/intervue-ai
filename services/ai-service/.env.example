# ai-service environment

# Backend internal API (must match backend's INTERNAL_SERVICE_SECRET)
BACKEND_INTERNAL_URL=http://localhost:3000/api/internal
BACKEND_INTERNAL_TOKEN=change-me-internal-secret

# MCP HTTP transport
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3100

# LLM providers
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-4o-mini

# Secondary evaluator (Phase 4 - two-model scoring)
GROQ_API_KEY=
GROQ_SECONDARY_MODEL=llama-3.3-70b-versatile

# Misc
NODE_ENV=development
