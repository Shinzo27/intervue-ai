{
  "name": "ai-service",
  "version": "1.0.0",
  "description": "Intervue AI MCP server: pipeline/scoring/action tools + conversational interviewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts http",
    "dev:stdio": "tsx src/index.ts stdio",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.eval.json",
    "start": "node dist/index.js http",
    "start:stdio": "node dist/index.js stdio",
    "test": "tsx --test \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "test:e2e": "python scripts/test_mcp.py",
    "eval": "tsx evals/run.ts",
    "test:e2e:interviewer": "python scripts/test_interviewer.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
