{
  "name": "intervue-ai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:infra": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "docker:up": "docker compose -f infra/compose/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/compose/docker-compose.yml down",
    "demo:seed": "python infra/postman/run_collection.py",
    "verify": "pnpm --filter ai-service test && pnpm --filter backend test:e2e && pnpm --filter ai-service test:e2e",
    "verify:unit": "pnpm --filter ai-service test",
    "verify:api": "pnpm --filter backend test:e2e",
    "verify:mcp": "pnpm --filter ai-service test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
